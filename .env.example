# Local development
ENVIRONMENT=development
SQLITE_PATH=efootball.db

# Production API on Render
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
ADMIN_KEY=generate-a-long-random-secret
CORS_ORIGINS=https://efootball2026.online,https://www.efootball2026.online

# Vercel frontend
NEXT_PUBLIC_API_URL=https://efootball-tournament.onrender.com
