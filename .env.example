# Shared
ENVIRONMENT=development
ADMIN_KEY=generate-a-long-random-secret

# FastAPI tournament API (apps/api) — Render or local
SQLITE_PATH=efootball.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
CORS_ORIGINS=https://efootball2026.online,https://www.efootball2026.online,https://efootball-inky.vercel.app
REDIS_URL=
SENTRY_DSN=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Next.js site (repo root) — Vercel or local
NEXT_PUBLIC_API_URL=https://efootball-tournament-kwq4.onrender.com
TOURNAMENT_API_URL=https://efootball-tournament-kwq4.onrender.com
# Same ADMIN_KEY as Render. Server-only on Next.js/Vercel — injected as X-Admin-Key by /api/backend. Never NEXT_PUBLIC_*.
CRON_SECRET=

# Instagram Graph API (Vercel env — never commit real tokens)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Optional: upload evidence from the Next.js app if FastAPI Cloudinary is unset
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=match-evidence

# AI studio — OpenRouter is the default video/copy path when DashScope is unset
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=alibaba/wan-2.6
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_HOST=
GROQ_API_KEY=
HF_TOKEN=
